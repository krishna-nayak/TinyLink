{
	"info": {
		"_postman_id": "5bed887e-8ec6-4b65-88ba-bc4faf2c6407",
		"name": "TinyLink API - Only API Endpoints",
		"description": "Postman collection with only the API endpoints for TinyLink (create, list, stats, delete). Uses {{baseUrl}} and {{code}} variables.",
		"schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json",
		"_exporter_id": "35058372"
	},
	"item": [
		{
			"name": "Create short link",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"url\": \"https://example.com\",\n  \"short_key\": \"optionalKey\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/api/links"
			},
			"response": []
		},
		{
			"name": "List all links",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/links"
			},
			"response": []
		},
		{
			"name": "Get stats for a code",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/links/:code",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"links",
						":code"
					],
					"variable": [
						{
							"key": "code",
							"value": "optionalKey"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Delete a link by code",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/links/:code",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"links",
						":code"
					],
					"variable": [
						{
							"key": "code",
							"value": "optionalKey"
						}
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000"
		},
		{
			"key": "code",
			"value": "yourcode"
		}
	]
}